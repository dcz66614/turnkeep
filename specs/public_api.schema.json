  "invariants": [
    "remember: no silent overwrite; same normalised value reuses active record, different value -> conflict",
    "correct/retract/resolve: require expected_revision (CAS); version mismatch -> VERSION_CONFLICT",
    "finish: same-transaction snapshot check, idempotent replay by request digest first, then STALE_SNAPSHOT",
    "parent_ids: AND semantics, same scope only, no cycles; omitted parents are server-filled from snapshot read set",
    "actor/user_id in request body NEVER overrides transport-bound principal; actor is a label, not auth",
    "active != truth; retract != erase; receipt = local SQLite commit only, not external atomicity",
    "terminal states are terminal; scope_epoch is coarse (may mis-block unrelated writes in same scope)"
  ],
  "state_machine": {
    "states": [
      "active",
      "conflicted",
      "superseded",
      "retracted",
      "tainted",
      "expired",
      "erased"
    ],
    "implemented_in_starter": [
      "active",
      "conflicted",
      "superseded",
      "retracted",
      "tainted"
    ],
    "product_only": [
      "expired",
      "erased"
    ],
    "transitions": {
      "active->conflicted": "remember with different value, no correction relation",
      "active->superseded": "correct (old) / resolve_conflict (candidates)",
      "active->tainted": "any parent becomes unavailable (correct/retract/conflict)",
      "active->retracted": "retract (history kept; NOT erase)",
      "conflicted->active": "only via resolve_conflict with FULL candidate set; single-candidate resolve rejected (CANDIDATE_SET_CHANGED)",
      "tainted->active": "NOT by re-read alone; needs new record with explicit replaces_ids / new evidence",
      "any->erased": "product-only, T038; starter does not implement"
    }
  }
