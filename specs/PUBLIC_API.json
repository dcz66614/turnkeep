    "/v1/runs/{id}/changes": {
      "get": {
        "operationId": "changes",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Changed keys, affected record IDs, cause paths and current epoch. A diff is not authorization or proof of successful recomputation."
          }
        },
        "description": "Design-only: no HTTP route implements this yet. "
      }
    },
    "/v1/memories/{id}": {
      "get": {
        "operationId": "inspect_memory",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "in": "query",
            "name": "include_history",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current record visibility evaluated at read time."
          },
          "404": {
            "description": "Absent, not visible, or inaccessible."
          }
        },
        "description": "Design-only: no HTTP route implements this yet. "
      }
    }
