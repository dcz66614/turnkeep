  "components": {
    "securitySchemes": {
      "localToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Local per-install token; not a complete remote multi-tenant authorization system."
      }
    },
    "schemas": {
      "Remember": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "kind": {
            "enum": [
              "requirement",
              "fact",
              "decision",
              "attempt",
              "procedure",
              "handoff"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "ref"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "user_statement",
                    "tool_observation",
                    "agent_inference",
                    "imported_text"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string"
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "excerpt": {
                  "type": "string",
                  "maxLength": 8192
                }
              }
            },
            "minItems": 1,
            "maxItems": 64
          },
          "parent_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 512,
            "uniqueItems": true
          },
          "replaces_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 512,
            "uniqueItems": true
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "scope",
          "key",
          "value",
          "kind",
          "sources"
        ]
      },
      "Begin": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "budget_chars": {
            "type": "integer",
            "minimum": 256,
            "maximum": 64000,
            "default": 12000
          }
        },
        "required": [
          "scope",
          "task"
        ]
      },
      "Finish": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {},
          "parent_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 512,
            "uniqueItems": true
          }
        },
        "required": [
          "result"
        ]
      },
      "Correct": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "new_value": {},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "ref"
            ],
            "properties": {
              "type": {
                "enum": [
                  "user_statement",
                  "tool_observation",
                  "agent_inference",
                  "imported_text"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "excerpt": {
                "type": "string",
                "maxLength": 8192
              }
            }
          }
        },
        "required": [
          "expected_revision",
          "new_value",
          "source"
        ]
      },
      "Retract": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "expected_revision",
          "reason"
        ]
      },
      "Resolve": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "expected_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "minItems": 1,
            "maxItems": 128,
            "description": "Complete current active/conflicted candidate set with revisions. At least one current candidate must be conflicted. A lone conflicted candidate after retraction is valid. Server validates exact candidate-set equality."
          },
          "new_value": {},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "ref"
            ],
            "properties": {
              "type": {
                "enum": [
                  "user_statement",
                  "tool_observation",
                  "agent_inference",
                  "imported_text"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "excerpt": {
                "type": "string",
                "maxLength": 8192
              }
            }
          }
        },
        "required": [
          "scope",
          "key",
          "expected_candidates",
          "new_value",
          "source"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "STALE_SNAPSHOT",
              "VERSION_REQUIRED",
              "VERSION_CONFLICT",
              "CONFLICT_REQUIRES_RESOLVE",
              "CANDIDATE_SET_CHANGED",
              "INVALID_PARENT",
              "CYCLE_DETECTED",
              "SCOPE_MISMATCH",
              "IDEMPOTENCY_MISMATCH",
              "REPLACEMENT_REQUIRED",
              "NOT_FOUND",
              "FORBIDDEN",
              "STORE_BUSY",
              "INVALID_INPUT",
              "UNSUPPORTED"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ]
      },
      "Memory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "active",
              "conflicted",
              "superseded",
              "retracted",
              "tainted",
              "expired",
              "erased"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "ref"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "user_statement",
                    "tool_observation",
                    "agent_inference",
                    "imported_text"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string"
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "excerpt": {
                  "type": "string",
                  "maxLength": 8192
                }
              }
            }
          },
          "parent_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 512,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "scope",
          "key",
          "value",
          "kind",
          "state",
          "revision",
          "created_at",
          "sources",
          "parent_ids"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          },
          "epoch": {
            "type": "integer",
            "minimum": 0
          },
          "request_digest": {
            "type": "string",
            "minLength": 1
          },
          "replayed": {
            "type": "boolean"
          },
          "assurance": {
            "const": "accepted_at_commit_only"
          }
        },
        "required": [
          "run_id",
          "record_id",
          "accepted_at",
          "epoch",
          "request_digest",
          "replayed",
          "assurance"
        ]
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "scope_epoch": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "open",
              "accepted",
              "abandoned"
            ]
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Memory"
            }
          },
          "observed_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 512,
            "uniqueItems": true
          },
          "truncated": {
            "type": "boolean"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "id",
          "scope",
          "task",
          "scope_epoch",
          "status",
          "records",
          "observed_ids",
          "truncated",
          "conflicts"
        ]
      }
    }
  }
}
