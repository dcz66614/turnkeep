{
  "openapi": "3.1.0",
  "info": {
    "title": "Turnkeep planned local API",
    "version": "0.1.0-design",
    "description": "Implemented local workbench API under /api/v1 (see paths). Identity is transport-bound; request bodies cannot assign principals. Intended for optional loopback UI. MCP adapters map the same operations. The Idempotency-Key header is required (8-128 chars) on all six POST operations. The two GET entries are design-only."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7841",
      "description": "Proposed port; handle occupied ports explicitly."
    }
  ],
  "security": [
    {
      "localToken": []
    }
  ],
  "paths": {
    "/api/v1/remember": {
      "post": {
        "operationId": "remember",
        "description": "Semantic authority: CORE_CONTRACT.md. MCP name: turnkeep_remember",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Remember"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed; no unverified performance or factual truth implied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Memory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found or inaccessible"
          },
          "409": {
            "description": "State conflict; inspect error code before retry. STALE requires a new reading/recomputation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Store temporarily busy"
          }
        }
      }
    },
